# Required: Your Google AI Studio API key
# Get one at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Accepted alias for GOOGLE_API_KEY (GOOGLE_API_KEY wins if both are set).
# GEMINI_API_KEY=your_google_api_key_here

# Optional: Gemini model to use (default: gemini-2.5-flash; gemini-2.5-pro is no longer
# available to new API keys as of 2026)
GEMINI_MODEL=gemini-2.5-flash

# Concurrency is a CLI flag, not an env var: `--concurrency <n>` (default 5).
# (2026-09-09 sweep: a `MAX_CONCURRENCY` env var was documented here and in
# docs/SPEC.md but was never read by the code; the flag is the only control.)

# Optional: Log verbosity — silent | error | warn | info | debug.
# With the variable unset (or set to an unrecognised value) the logger is
# SILENT; this template sets info so a copied .env is verbose by default.
LOG_LEVEL=info

# ─── Cost-estimate overrides (added to .env.example 2026-09-09) ───────────────
# The cost meter prices a run from a per-model table in
# src/infrastructure/cost-meter.ts (source: ai.google.dev pricing, 2026-09-04),
# falling back to the most expensive known rate for an unknown model so the
# --max-cost-usd cap trips early rather than late. These two override either
# component, in USD per 1,000,000 tokens. Output tokens include thinking
# tokens. They affect the *estimate* only; on the OpenRouter path the
# provider-reported cost is recorded separately in run_manifest.json.
# GEMINI_INPUT_USD_PER_1M=0.30
# GEMINI_OUTPUT_USD_PER_1M=2.50

# Optional: retries after a failed model call (default: 3, i.e. 4 attempts).
# Transient failures only — HTTP 429/500/502/503/504 and network errors — with
# exponential backoff and full jitter (2s base, 30s cap), honouring Retry-After
# and Google's RetryInfo.retryDelay when the error carries one. 400/401/403/404
# and validation errors are never retried. Set to 0 to disable retrying.
# GEMINI_MAX_RETRIES is accepted as an alias; AI_MAX_RETRIES wins if both are set.
AI_MAX_RETRIES=3

# Optional: model provider (default: google). Set to "openrouter" to run the
# unchanged pipeline on any OpenRouter vision model via its OpenAI-compatible
# API (ADR-006 — second provider for the ADR-004 monoculture test). Note: the
# OpenRouter path has no Google Search grounding.
AI_PROVIDER=google

# Required when AI_PROVIDER=openrouter. Get one at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: OpenRouter model id (default: google/gemini-2.5-flash). Any
# vision-capable model works, e.g. openai/gpt-4o, anthropic/claude-sonnet-4,
# qwen/qwen2.5-vl-72b-instruct. See https://openrouter.ai/models?modality=image
OPENROUTER_MODEL=google/gemini-2.5-flash

# Optional: image resolution policy for the pre-flight that runs before every
# analysis request (default: auto). The target long edge is detected from the
# provider/model's published effective input resolution — Gemini 1536 px (2 ×
# 768 px tiles), Gemma 3/4 896 px, Claude 1568 px, Qwen-VL 1000 px, unknown
# models 1024 px — and a file that is already within it (PNG/JPEG, 8-bit, no
# alpha) is forwarded byte-for-byte with no re-encode.
#   auto     — the table above, trimmed per image to the model's visual-token
#              budget; best quality the model can actually use (default)
#   max      — the model's published ceiling (Gemini 3072, Claude 4.7+ 2576,
#              Qwen-VL 3584); more bytes, and more tokens on per-pixel models
#   economy  — 768 px, exactly one Gemini tile; smallest payload
IMAGE_QUALITY=auto

# Optional: hard override of the detected long edge, in pixels. Wins over
# IMAGE_QUALITY and over the per-model table, and disables the tile-alignment
# and visual-token-budget trims. Unset, zero or non-numeric means "use the
# policy". Only set this if you know the resolution you want.
# IMAGE_MAX_DIM=1024

# Optional: set to 1 to re-encode a JPEG source as JPEG q=90 instead of lossless
# PNG when it has to be re-encoded at all. Smaller payloads for photographic
# input, at the cost of compression artefacts — leave it off for anything read
# diagnostically.
# IMAGE_JPEG_FOR_PHOTO=1

# ─── Input limits (AI Act Art. 15 robustness; THREAT_MODEL T6) ────────────────
# Both are enforced by the file scanner before anything is uploaded, and both
# are refusals (exit code 2), not warnings — the oversized file is exactly the
# one that would have been decoded into memory and billed. A blank, zero or
# non-integer value falls back to the default rather than failing the run.

# Optional: hard ceiling on images accepted in one run (default: 500).
# Bounding the batch also bounds spend; --series selects a subset instead.
MAX_IMAGES_PER_RUN=500

# Optional: hard ceiling on a single image file, in bytes (default: 52428800 = 50 MB).
MAX_IMAGE_BYTES=52428800

# ─── Governance / audit ───────────────────────────────────────────────────────
# There is nothing to configure here: every run writes a hash-sealed
# <outputDir>/run_manifest.json (AI Act Art. 12, NIST MANAGE 4.1) with no env
# var and no opt-out. The related controls are CLI flags, not settings:
#
#   --manifest-chain <file>  append this run's hash to an append-only ledger,
#                            linked to the previous run (tamper-evident chain)
#   --reviewer "<name>"      record a human-oversight attestation (Art. 14)
#   --allow-phi              acknowledge PHI-scan findings and continue
#   --strict-phi             refuse to upload anything if the PHI scan fires
#                            (exit 7, before the first request)
#
#   medical-imaging verify-manifest <outputDir> [--chain <file>]
#                            re-hash a completed run offline (exit 0 / 6)
#
# See docs/architecture/decisions/ADR-007-run-manifest-audit-ledger.md.
